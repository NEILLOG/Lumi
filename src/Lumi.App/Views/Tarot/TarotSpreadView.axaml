<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumi.App.Views.Tarot.TarotSpreadView">
  <!--
    工具卡片裡的牌陣圖（plan/25 D9、25B 步驟 5）：水平可捲動，垂直不捲（卡片本身就會長高）。
    牌的位置與旋轉在 TarotSpreadView.axaml.cs 依 TarotSpreadLayout 算出來。
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Canvas x:Name="Stage" />
  </ScrollViewer>
</UserControl>
