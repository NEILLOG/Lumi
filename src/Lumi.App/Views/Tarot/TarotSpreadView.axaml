<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumi.App.Views.Tarot.TarotSpreadView">
  <!--
    牌陣圖（plan/25 D9、25D；ui-spec 3.1）：水平可捲動，垂直不捲（附件本身就會長高）。
    牌、位置名稱與編號圓點的位置在 TarotStageLayout 算出，TarotSpreadView.axaml.cs 照擺。
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Canvas x:Name="Stage" />
  </ScrollViewer>
</UserControl>
