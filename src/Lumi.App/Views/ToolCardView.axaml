<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:md="using:Lumi.App.Markdown"
             xmlns:views="using:Lumi.App.Views"
             x:Class="Lumi.App.Views.ToolCardView"
             x:DataType="vm:ToolCardViewModel">
  <!--
    一次工具呼叫的卡片（ui-spec 第 4、5 節）：預設收合，標題「動作 · 對象 · 結果摘要 … 耗時 ›」；
    執行中與等待允許強制展開；等待允許時確認區嵌在卡片內。只用 token 上色。
    牌陣與圖片不畫在卡片上，是回覆附件（ui-spec 3.1，ReplyAttachmentsView）。
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
    <!-- 卡片（ui-guide.html 第 7 節）：Border.card 的圓角 14、邊框；Padding 交給標題按鈕與內容區各自的 Margin，所以這裡歸零 -->
    <Style Selector="Border.toolcard">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.toolcard.awaiting">
      <Setter Property="Background" Value="{DynamicResource LumiWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.toolcard.failed">
      <Setter Property="Background" Value="{DynamicResource LumiDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiDangerBorderBrush}" />
    </Style>
    <Style Selector="Border.toolcard.denied">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.cardheader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <!-- 整列標題是按鈕：Hover／Pressed 不換底，強制展開時的停用也不變灰；Fluent 的狀態規則會把前景改成黑色，所以明確寫回 Text -->
    <Style Selector="Button.cardheader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.cardheader:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.cardheader:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <Style Selector="TextBlock.cardlabel">
      <Setter Property="Foreground" Value="{DynamicResource LumiTextMutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 權限確認區的按鈕：一個 Primary（或 danger）、其餘 secondary／tertiary；高度與內距一致 -->
    <Style Selector="Button.confirm">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- 執行中：圖示轉圈（只有執行中才加 spin class，結束後動畫跟著移除） -->
    <Style Selector="ctl|LumiIcon.spin">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Panel>
  <!-- show_details 成功：展開的內容卡（標題＋Markdown＋複製），不走收合的工具卡 -->
  <Border x:Name="DetailsCard" Classes="card toolcard" IsVisible="{Binding ShowDetailsCard}">
    <StackPanel Spacing="8" Margin="16,12,16,16">
      <Grid ColumnDefinitions="24,*,Auto">
        <ctl:LumiIcon Grid.Column="0" Data="{StaticResource LumiIconCheck}" Foreground="{DynamicResource LumiSuccessBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" />
        <ctl:EmojiTextBlock Grid.Column="1" Text="{Binding DetailsHeader}" TextTrimming="CharacterEllipsis" MaxLines="1" FontWeight="SemiBold"
                            VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCard}" />
        <TextBlock Grid.Column="2" Text="{Binding DetailsCharacters}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <md:MarkdownView x:Name="DetailsMarkdown" Markdown="{Binding DetailsMarkdown}" IsStreaming="False" />
      <Button x:Name="DetailsCopyButton" Classes="tertiary small" HorizontalAlignment="Left" Content="{Binding CopyLabel}"
              Command="{Binding CopyResultCommand}" />
    </StackPanel>
  </Border>

  <Border x:Name="Card" Classes="card toolcard" IsVisible="{Binding ShowRegularCard}"
          Classes.awaiting="{Binding IsAwaiting}" Classes.failed="{Binding IsFailed}" Classes.denied="{Binding IsDenied}">
    <StackPanel>
      <Button Classes="cardheader" Command="{Binding ToggleCommand}">
        <Grid ColumnDefinitions="24,*,Auto,Auto" VerticalAlignment="Center">
          <!-- 狀態圖示（形狀不同，不只靠顏色）：執行中轉圈、成功勾、失敗叉、等待三角、已拒絕禁止符號 -->
          <Panel Grid.Column="0" Width="16" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ctl:LumiIcon IsVisible="{Binding IsRunning}" Classes.spin="{Binding IsRunning}" Data="{StaticResource LumiIconLoader}"
                          Foreground="{DynamicResource LumiInfoBrush}" />
            <ctl:LumiIcon IsVisible="{Binding IsSucceeded}" Data="{StaticResource LumiIconCheck}" Foreground="{DynamicResource LumiSuccessBrush}" />
            <ctl:LumiIcon IsVisible="{Binding IsFailed}" Data="{StaticResource LumiIconX}" Foreground="{DynamicResource LumiDangerBrush}" />
            <ctl:LumiIcon IsVisible="{Binding IsAwaiting}" Data="{StaticResource LumiIconAlertTriangle}" Foreground="{DynamicResource LumiWarningIconBrush}" />
            <ctl:LumiIcon IsVisible="{Binding IsDenied}" Data="{StaticResource LumiIconBan}" Foreground="{DynamicResource LumiTextMutedBrush}" />
          </Panel>
          <ctl:EmojiTextBlock Grid.Column="1" Text="{Binding Title}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" MaxLines="1"
                              VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCard}" />
          <TextBlock Grid.Column="2" IsVisible="{Binding HasDuration}" Text="{Binding DurationText}" Classes="muted"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
          <Panel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
            <ctl:LumiIcon IsVisible="{Binding !IsOpen}" Data="{StaticResource LumiIconChevronRight}" Foreground="{DynamicResource LumiTextMutedBrush}" />
            <ctl:LumiIcon IsVisible="{Binding IsOpen}" Data="{StaticResource LumiIconChevronDown}" Foreground="{DynamicResource LumiTextMutedBrush}" />
          </Panel>
        </Grid>
      </Button>

      <StackPanel IsVisible="{Binding IsOpen}" Spacing="8" Margin="16,0,16,16">
        <!-- 確認區（等待允許時）：這次會做什麼、按鈕依權限等級 -->
        <StackPanel IsVisible="{Binding IsAwaiting}" Spacing="8">
          <!-- 排程紀錄的確認（M24 4.3）：說明這個權限沒有授權、所以停下來問 -->
          <TextBlock IsVisible="{Binding ShowAwaitingNote}" Text="{Binding AwaitingNote}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
          <StackPanel IsVisible="{Binding ShowGenericConfirm}" Spacing="8">
          <TextBlock Text="{Binding PermissionNote}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
          <!-- 警告（M17）：每則一列，淡底＋三角圖示；沒有警告時整塊不佔位置 -->
          <ItemsControl x:Name="ApprovalWarnings" IsVisible="{Binding HasWarnings}" ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Background="{DynamicResource LumiWarningBackgroundBrush}" BorderBrush="{DynamicResource LumiWarningBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource LumiRadiusInput}" Padding="12,8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ctl:LumiIcon Data="{StaticResource LumiIconAlertTriangle}" Size="16" Foreground="{DynamicResource LumiWarningTextBrush}"
                                  VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ctl:EmojiTextBlock IsVisible="{Binding HasPreviewDetail}" Text="{Binding PreviewDetail}" TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding IsDestructive}" Text="{x:Static res:Strings.Tool_Irreversible}"
                     FontWeight="SemiBold" Foreground="{DynamicResource LumiDangerBrush}" />
          <!-- 按鈕層級：一般等級 = 允許一次（primary）、本次對話都允許（secondary）、拒絕（tertiary）；
               Destructive = 允許執行（danger，紅框紅字）、拒絕（secondary），沒有 primary -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AllowOnceButton" Classes="primary confirm" IsVisible="{Binding !IsDestructive}" Content="{x:Static res:Strings.Tool_AllowOnce}"
                    Command="{Binding AllowOnceCommand}" />
            <Button x:Name="AllowExecuteButton" Classes="danger confirm" IsVisible="{Binding IsDestructive}" Content="{x:Static res:Strings.Tool_AllowExecute}"
                    Command="{Binding AllowOnceCommand}" />
            <Button x:Name="AllowConversationButton" Classes="secondary confirm" IsVisible="{Binding ShowAllowForConversation}"
                    Content="{Binding AllowConversationLabel}" Command="{Binding AllowForConversationCommand}" />
            <Button x:Name="DenyButton" Classes="confirm" Classes.tertiary="{Binding !IsDestructive}" Classes.secondary="{Binding IsDestructive}"
                    Content="{x:Static res:Strings.Tool_Deny}" Command="{Binding DenyCommand}" />
          </StackPanel>
          </StackPanel>

          <!-- 技能確認（M29 5.7、D8）：要存成技能的內容，唯讀可選取；取代現有技能時警告。按鈕只有「儲存」（等同允許一次）與「不要」（等同拒絕），沒有「本次對話都允許」、不能編輯 -->
          <StackPanel IsVisible="{Binding ShowSkillConfirm}" Spacing="12">
            <TextBlock Text="{x:Static res:Strings.Skills_ConfirmTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Skills_FieldName}" Classes="cardlabel" />
              <ctl:EmojiTextBlock Text="{Binding SkillName}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Skills_FieldDescription}" Classes="cardlabel" />
              <ctl:EmojiTextBlock Text="{Binding SkillDescription}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Skills_FieldBody}" Classes="cardlabel" />
              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding SkillBody}" TextWrapping="Wrap" />
              </ScrollViewer>
            </StackPanel>
            <!-- 取代警告：Warning 色、淡底＋三角圖示，和確認區的網址警告同一樣式 -->
            <Border IsVisible="{Binding ShowReplaceWarning}" Background="{DynamicResource LumiWarningBackgroundBrush}"
                    BorderBrush="{DynamicResource LumiWarningBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource LumiRadiusInput}" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ctl:LumiIcon Data="{StaticResource LumiIconAlertTriangle}" Size="16" Foreground="{DynamicResource LumiWarningTextBrush}"
                              VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding ReplaceWarningText}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveSkillButton" Classes="primary confirm" Content="{x:Static res:Strings.Skills_ConfirmSave}"
                      Command="{Binding AllowOnceCommand}" />
              <Button x:Name="SaveSkillDenyButton" Classes="tertiary confirm" Content="{x:Static res:Strings.Skills_ConfirmDeny}"
                      Command="{Binding DenyCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- 建立排程的確認（M24 4.4，草圖 ScheduleCreate）：欄位、執行時不再詢問的動作、建立／拒絕。卡片內不再巢狀卡片 -->
          <StackPanel IsVisible="{Binding ShowScheduleConfirm}" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Schedule_Field_Name}" Classes="cardlabel" />
              <ctl:EmojiTextBlock Text="{Binding ScheduleName}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Schedule_Field_When}" Classes="cardlabel" />
              <TextBlock Text="{Binding ScheduleWhen}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Schedule_Field_Prompt}" Classes="cardlabel" />
              <ctl:EmojiTextBlock Text="{Binding SchedulePrompt}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Schedule_Field_Model}" Classes="cardlabel" />
              <TextBlock Text="{Binding ScheduleModel}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Schedule_Field_Records}" Classes="cardlabel" />
              <TextBlock Text="{Binding ScheduleRecords}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Schedule_Field_Scope}" Classes="cardlabel" />
              <TextBlock Text="{Binding ScheduleScope}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{x:Static res:Strings.Schedule_GrantHeading}" Classes="cardlabel" />
              <TextBlock Text="{x:Static res:Strings.Schedule_GrantNote}" Classes="muted" TextWrapping="Wrap" />

              <!-- 讀取：固定勾選、不能取消（本來就不詢問） -->
              <CheckBox x:Name="GrantReadCheck" IsChecked="True" IsEnabled="False">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Static res:Strings.Schedule_Grant_Read}" FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static res:Strings.Schedule_Grant_ReadNote}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>

              <CheckBox x:Name="GrantWriteCheck" IsChecked="{Binding ScheduleWrite, Mode=TwoWay}">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static res:Strings.Schedule_Grant_Write}" FontWeight="SemiBold" />
                    <Border Classes="badge" IsVisible="{Binding WriteSuggested}">
                      <TextBlock Text="{x:Static res:Strings.Schedule_Suggested}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{x:Static res:Strings.Schedule_Grant_WriteNote}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>

              <CheckBox x:Name="GrantNetworkCheck" IsChecked="{Binding ScheduleNetwork, Mode=TwoWay}">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static res:Strings.Schedule_Grant_Network}" FontWeight="SemiBold" />
                    <Border Classes="badge" IsVisible="{Binding NetworkSuggested}">
                      <TextBlock Text="{x:Static res:Strings.Schedule_Suggested}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{x:Static res:Strings.Schedule_Grant_NetworkNote}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>

              <!-- 破壞性操作：單獨一列、標無法復原、預設不勾；勾了確認鍵才會變 danger -->
              <Border Height="1" Margin="0,4" Background="{DynamicResource LumiBorderBrush}" />
              <CheckBox x:Name="GrantDestructiveCheck" IsChecked="{Binding ScheduleDestructive, Mode=TwoWay}">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static res:Strings.Schedule_Grant_Destructive}" FontWeight="SemiBold" />
                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource LumiDangerBackgroundBrush}">
                      <TextBlock Text="{x:Static res:Strings.Schedule_Grant_DestructiveBadge}" FontSize="{DynamicResource LumiFontSizeCaption}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource LumiDangerBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding ScheduleDestructiveNote}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>

              <TextBlock Text="{x:Static res:Strings.Schedule_AlwaysAskNote}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CreateScheduleButton" Classes="primary confirm" IsVisible="{Binding !ScheduleDestructive}"
                        Content="{x:Static res:Strings.Schedule_Create_Confirm}" Command="{Binding CreateScheduleCommand}" />
                <Button x:Name="CreateScheduleDangerButton" Classes="danger confirm" IsVisible="{Binding ScheduleDestructive}"
                        Content="{x:Static res:Strings.Schedule_Create_ConfirmDestructive}" Command="{Binding CreateScheduleCommand}" />
                <Button x:Name="CreateScheduleDenyButton" Classes="tertiary confirm" Content="{x:Static res:Strings.Schedule_Create_Deny}"
                        Command="{Binding DenyCommand}" />
              </StackPanel>
              <TextBlock Text="{x:Static res:Strings.Schedule_Create_AfterNote}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock IsVisible="{Binding HasApprovalNote}" Text="{Binding ApprovalNote}" Classes="muted" />

        <!-- 建立排程成功後：下次執行與實際授權（解析不了就不顯示，標題與結果摘要仍在）；「查看」先只是文字 -->
        <StackPanel IsVisible="{Binding HasScheduleSummary}" Spacing="4">
          <TextBlock Text="{Binding ScheduleSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static res:Strings.Schedule_Created_ViewLink}" Foreground="{DynamicResource LumiAccentTextBrush}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static res:Strings.Tool_Arguments}" Classes="cardlabel" />
          <ctl:EmojiTextBlock Text="{Binding ArgumentsText}" TextWrapping="Wrap" FontFamily="{DynamicResource LumiMonoFont}"
                              FontSize="{DynamicResource LumiFontSizeCaption}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasResult}" Spacing="4">
          <TextBlock Text="{x:Static res:Strings.Tool_Result}" Classes="cardlabel" />
          <ctl:EmojiTextBlock x:Name="ResultText" Text="{Binding ResultDisplay}" TextWrapping="Wrap"
                              FontFamily="{DynamicResource LumiMonoFont}" FontSize="{DynamicResource LumiFontSizeCaption}" />
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <Button Classes="tertiary small" IsVisible="{Binding HasMoreResult}" Content="{Binding ShowFullLabel}"
                    Command="{Binding ToggleFullOutputCommand}" />
            <Button Classes="tertiary small" Content="{Binding CopyLabel}" Command="{Binding CopyResultCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
  </Panel>
</UserControl>
