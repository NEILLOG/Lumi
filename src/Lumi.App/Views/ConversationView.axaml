<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.App.ViewModels"
             xmlns:ctl="using:Lumi.App.Controls"
             xmlns:res="using:Lumi.App.Resources"
             xmlns:views="using:Lumi.App.Views"
             xmlns:md="using:Lumi.App.Markdown"
             x:Class="Lumi.App.Views.ConversationView"
             x:DataType="vm:WorkbenchViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi.App/Themes/ChatStyles.axaml" />
    <!--
      對話區的版面常數集中在這裡（Wide 值）：左右 Padding 64、訊息間距 24。
      RWD（UC）只要在根節點 class 下覆寫，例如 Window.compact Border.conversation-page { Padding = 24,24 }、
      Window.narrow ... { Padding = 16,24 }；不需要動下面的結構。
    -->
    <Style Selector="Border.conversation-page">
      <Setter Property="Padding" Value="64,24" />
    </Style>
    <Style Selector="StackPanel.conversation-stack">
      <Setter Property="Spacing" Value="24" />
    </Style>
    <!-- 歡迎區上下留白：Normal 上 32；short 縮成 8；veryshort 整個隱藏（外層 WelcomeHost，因為 WelcomePanel 的 IsVisible 綁了 ShowWelcome） -->
    <Style Selector="StackPanel#WelcomePanel">
      <Setter Property="Margin" Value="0,32,0,0" />
    </Style>
    <!-- 助理頭像：32 圓形、Soft 底、Accent 色文字 -->
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource LumiAccentSoftBrush}" />
    </Style>
    <!-- 訊息上方一行：名稱＋時間 -->
    <Style Selector="TextBlock.sender">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeBody}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource LumiTextBrush}" />
    </Style>
    <!-- 動作列按鈕：tertiary（無框），Caption 字級來自 small -->
    <Style Selector="Button.message-action">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      訊息寬度（RWD原則 3.3、計畫「工作台結構」）：FractionWidthLimiter 取「對話區內容寬度 × Fraction」與 MaxPixels 較小者。
      Wide：助理 ≤ 820 且 ≤ 內容區，使用者 ≤ 72%；Compact／Narrow：助理 92%、使用者 80%（沒有像素上限）。
    -->
    <Style Selector="ctl|FractionWidthLimiter.assistant">
      <Setter Property="Fraction" Value="1" />
      <Setter Property="MaxPixels" Value="820" />
    </Style>
    <Style Selector="ctl|FractionWidthLimiter.user">
      <Setter Property="Fraction" Value="0.72" />
    </Style>
    <Style Selector="Window.compact ctl|FractionWidthLimiter.assistant, Window.narrow ctl|FractionWidthLimiter.assistant">
      <Setter Property="Fraction" Value="0.92" />
      <Setter Property="MaxPixels" Value="{x:Static x:Double.PositiveInfinity}" />
    </Style>
    <Style Selector="Window.compact ctl|FractionWidthLimiter.user, Window.narrow ctl|FractionWidthLimiter.user">
      <Setter Property="Fraction" Value="0.8" />
    </Style>

    <!-- 支線（M36 4.8）：色條只在支線裡有。間距只用尺度（架構測試）：左框 4＋左內距 16＋列表左邊界 4 ＝ 內容往右 24（色條寬 3 改成 4） -->
    <Style Selector="Border#BranchRail.branch">
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
      <Setter Property="Padding" Value="16,0,0,0" />
    </Style>
    <Style Selector="Border#BranchRail.branch > ItemsControl">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <!-- 出處卡片、摘要卡：Surface、1px Border、圓角 14；內距由各卡自己設 -->
    <Style Selector="Border.branch-card">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource LumiRadiusCard}" />
    </Style>
    <!-- 剛帶回的摘要卡：Opacity 0→1、200ms（ui-spec 4.8 進入動畫；只在 Timeline 判定「剛帶回」時加上 class） -->
    <Style Selector="Border.branch-card.card-enter">
      <Style.Animations>
        <Animation Duration="0:0:0.2" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- 「問這段」的浮動工具列（E8）：高 32，內距 4，1px 框、圓角 10、浮起的陰影 -->
    <Style Selector="Border.ask-popup">
      <Setter Property="Background" Value="{DynamicResource LumiSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="{DynamicResource LumiCardHoverShadow}" />
    </Style>

    <!-- 高度規則（RWD原則 第 5 節）：short 訊息垂直間距 24 → 16、歡迎區留白縮小；veryshort 隱藏歡迎區 -->
    <Style Selector="Window.short StackPanel.conversation-stack, Window.veryshort StackPanel.conversation-stack">
      <Setter Property="Spacing" Value="16" />
    </Style>
    <Style Selector="Window.short StackPanel#WelcomePanel, Window.veryshort StackPanel#WelcomePanel">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Window.veryshort Border#WelcomeHost">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Compact：對話區左右 Padding 24、動作列只剩圖示 -->
    <Style Selector="Window.compact Border#ConversationPage.conversation-page">
      <Setter Property="Padding" Value="24,24" />
    </Style>
    <Style Selector="Window.compact TextBlock.action-label, Window.narrow TextBlock.action-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Narrow：Padding 16、隱藏歡迎區副標、隱藏時間與使用者名稱「你」（保留助理名稱）、助理頭像 24 -->
    <Style Selector="Window.narrow Border#ConversationPage.conversation-page">
      <Setter Property="Padding" Value="16,24" />
    </Style>
    <Style Selector="Window.narrow TextBlock#WelcomeSubtitle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.narrow TextBlock.message-time, Window.narrow StackPanel.user-header">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.narrow Border.avatar">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Window.narrow Border.avatar > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource LumiFontSizeCaption}" />
    </Style>
    <!-- 等待回應：三個 6px 圓點依序淡入、上浮 3px，1.2 秒一輪（ui-spec 3.1 R4）。只在看得到時套用，隱藏後動畫跟著停 -->
    <Style Selector="StackPanel.typing-dots > Ellipse">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Fill" Value="{DynamicResource LumiTextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.typing-dots[IsVisible=True] > Ellipse.dot1">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="-3" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="StackPanel.typing-dots[IsVisible=True] > Ellipse.dot2">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="-3" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="StackPanel.typing-dots[IsVisible=True] > Ellipse.dot3">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="-3" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <!-- 訊息流：歡迎區、一次性提示、訊息（使用者／助理／工具段落）、錯誤列。ScrollViewer 名稱 MessageScroller 保留給測試與自動捲動 -->
  <!-- BringIntoViewOnFocusChange 關閉：使用者文字可選取、會留住焦點，視窗失焦再啟用或滑鼠點擊時不該把訊息區捲回那段文字；鍵盤導覽改由 code-behind 處理 -->
  <!-- AllowAutoHide 關閉（FX-01）：自動隱藏的捲軸平常只是一條細線，對話很長時幾乎點不到；固定顯示成可以點的寬度 -->
  <Panel>
  <ScrollViewer x:Name="MessageScroller" BringIntoViewOnFocusChange="False" AllowAutoHide="False">
    <Border x:Name="ConversationPage" Classes="conversation-page">
      <StackPanel x:Name="ConversationStack" Classes="conversation-stack">
        <!-- 歡迎區：對話沒有任何訊息（且不在載入中）時顯示（RWD：narrow 隱藏副標、veryshort 整個隱藏） -->
        <Border x:Name="WelcomeHost">
        <StackPanel x:Name="WelcomePanel" IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center" Spacing="12">
          <Border x:Name="WelcomeIcon" IsVisible="{Binding ShowWelcomeIcon}" Width="64" Height="64" HorizontalAlignment="Center"
                  CornerRadius="{StaticResource LumiRadiusPanel}" Background="{DynamicResource LumiAccentSoftBrush}">
            <ctl:LumiIcon Data="{StaticResource LumiIconSparkle}" Size="32" Foreground="{DynamicResource LumiAccentBrush}" />
          </Border>
          <!-- 工作台小精靈（M27）：取代方塊；大小是角色框，內容由 WorkbenchSpritePresenter 放入，光暈溢出不佔版面 -->
          <Panel x:Name="WelcomeSpriteSlot" IsVisible="{Binding IsWorkbenchSpriteEnabled}" HorizontalAlignment="Center" />
          <TextBlock x:Name="WelcomeTitle" Text="{x:Static res:Strings.Workbench_WelcomeTitle}" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" FontSize="{DynamicResource LumiFontSizeTitle}" FontWeight="Bold" />
          <TextBlock x:Name="WelcomeSubtitle" Text="{x:Static res:Strings.Workbench_WelcomeSubtitle}" Classes="muted"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- 一次性提示：例如設定檔損毀已改用預設 -->
        <Border IsVisible="{Binding HasNotice}" Padding="16,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource LumiWarningTextBrush}" />
            <!-- 關閉提示：tertiary（次要、可略過；提示區只有這一顆按鈕，不搶 primary） -->
            <Button x:Name="DismissNoticeButton" Grid.Column="1" Classes="tertiary" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{x:Static res:Strings.Workbench_DismissNotice}" Command="{Binding DismissNoticeCommand}" />
          </Grid>
        </Border>

        <Grid>
        <!-- 支線裡訊息列表左邊有色條（4.8「色條」）；Classes.branch 綁 IsInBranch（36F 實作）。覆蓋條只在進入動畫時顯示 -->
        <Border x:Name="BranchRail" Classes.branch="{Binding IsInBranch}">
        <ItemsControl ItemsSource="{Binding ShownMessages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Classes="conversation-stack" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <!-- 工具段落（ToolRunViewModel 繼承 MessageViewModel，所以放前面先比對） -->
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:ToolRunViewModel">
              <views:ToolRunView />
            </DataTemplate>
            <!-- 上下文整理的分隔線（M22 22I）：「以上內容已整理成摘要」，右邊「查看摘要」，展開看摘要全文（可選取） -->
            <DataTemplate DataType="vm:CompactionDividerViewModel" x:DataType="vm:CompactionDividerViewModel">
              <Expander Classes="advanced" IsExpanded="{Binding IsSummaryOpen, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static res:Strings.Compact_Divider}">
                <Expander.Header>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Compact_Divider}" Classes="muted" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" Background="{DynamicResource LumiBorderBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ToggleText}" Foreground="{DynamicResource LumiAccentTextBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Expander.Header>
                <ctl:EmojiTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
              </Expander>
            </DataTemplate>
            <!-- 支線的出處卡片（M36 4.8）：訊息列表最上面，寬度同助理訊息；有選取的文字就標底色 -->
            <DataTemplate DataType="vm:BranchOriginViewModel" x:DataType="vm:BranchOriginViewModel">
              <ctl:FractionWidthLimiter Classes="assistant" HorizontalAlignment="Left">
                <Border x:Name="BranchOriginCard" Classes="branch-card" Padding="16,12" RenderTransformOrigin="0%,0%">
                  <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ctl:LumiIcon Data="{StaticResource LumiIconGitBranch}" Size="12" Foreground="{DynamicResource LumiAccentTextBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Eyebrow}" FontSize="{DynamicResource LumiFontSizeCaption}" FontWeight="Bold"
                                 Foreground="{DynamicResource LumiAccentTextBrush}" />
                    </StackPanel>
                    <Border BorderThickness="2,0,0,0" BorderBrush="{DynamicResource LumiBorderStrongBrush}" Padding="12,0,0,0">
                      <WrapPanel>
                        <ctl:EmojiTextBlock Text="{Binding ExcerptBefore}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource LumiTextMutedBrush}" />
                        <Border IsVisible="{Binding HasHighlight}" Background="{DynamicResource LumiAccentSoftBrush}">
                          <ctl:EmojiTextBlock Text="{Binding ExcerptQuote}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource LumiTextMutedBrush}" />
                        </Border>
                        <ctl:EmojiTextBlock Text="{Binding ExcerptAfter}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource LumiTextMutedBrush}" />
                      </WrapPanel>
                    </Border>
                    <ctl:EmojiTextBlock IsVisible="{Binding ExtraQuoteText, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding ExtraQuoteText}"
                                        TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource LumiTextMutedBrush}" />
                  </StackPanel>
                </Border>
              </ctl:FractionWidthLimiter>
            </DataTemplate>
            <!-- 上一層的摘要卡（M36 4.8）：置中、寬度同助理訊息的上限；標頭、摘要全文（可選取）、「看完整支線」 -->
            <DataTemplate DataType="vm:BranchSummaryCardViewModel" x:DataType="vm:BranchSummaryCardViewModel">
              <ctl:FractionWidthLimiter Classes="assistant" HorizontalAlignment="Center">
                <Border Classes="branch-card" Classes.card-enter="{Binding PlayEnterAnimation}" Padding="16">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource LumiAccentSoftBrush}" VerticalAlignment="Top">
                        <ctl:LumiIcon Data="{StaticResource LumiIconGitMerge}" Size="16" Foreground="{DynamicResource LumiAccentTextBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource LumiTextBrush}" VerticalAlignment="Center" />
                          <Border Classes="badge" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Branch_StatusMerged}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding MetaText}" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="tertiary" VerticalAlignment="Top" Command="{Binding ToggleCommand}"
                              ToolTip.Tip="{Binding ToggleTip}" AutomationProperties.Name="{Binding ToggleTip}">
                        <Panel>
                          <ctl:LumiIcon IsVisible="{Binding IsExpanded}" Data="{StaticResource LumiIconChevronUp}" Size="16" />
                          <ctl:LumiIcon IsVisible="{Binding IsExpanded, Converter={x:Static BoolConverters.Not}}" Data="{StaticResource LumiIconChevronDown}" Size="16" />
                        </Panel>
                      </Button>
                    </Grid>
                    <md:MarkdownView IsVisible="{Binding IsExpanded}" Markdown="{Binding Summary}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Button Grid.Column="0" Classes="tertiary small" VerticalAlignment="Center"
                              Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).OpenBranchCommand}"
                              CommandParameter="{Binding ConversationId}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{x:Static res:Strings.Branch_CardOpen}" VerticalAlignment="Center" />
                          <ctl:LumiIcon Data="{StaticResource LumiIconChevronRight}" Size="12" />
                        </StackPanel>
                      </Button>
                      <!-- 還沒交出：下一則訊息會一起讀到這段摘要（右邊的說明） -->
                      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Branch_CardPending}" Classes="muted" TextWrapping="Wrap"
                                 TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 IsVisible="{Binding IsPending}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </ctl:FractionWidthLimiter>
            </DataTemplate>
            <DataTemplate DataType="vm:MessageViewModel" x:DataType="vm:MessageViewModel">
              <Panel>
                <!-- 使用者：靠右；上方是「你」與時間，再來是送出當時帶的檔案、資料夾、圖片 chip，最後是 UserBubble 底色的氣泡 -->
                <ctl:FractionWidthLimiter Classes="user" IsVisible="{Binding IsUser}">
                <StackPanel HorizontalAlignment="Right" Spacing="8">
                  <StackPanel Classes="user-header" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <TextBlock Classes="sender" Text="{x:Static res:Strings.Workbench_You}" />
                    <TextBlock Classes="muted message-time" Text="{Binding TimeText}" VerticalAlignment="Center" />
                    <!-- 排程紀錄裡的使用者訊息（那次執行送出的 prompt）標「排程」（M24 4.7.2） -->
                    <Border Classes="badge" IsVisible="{Binding ShowScheduleBadge}" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static res:Strings.Schedule_RunBadge}" />
                    </Border>
                  </StackPanel>
                  <ItemsControl IsVisible="{Binding HasAttachments}" ItemsSource="{Binding Attachments}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MessageChipViewModel">
                        <!-- 一個 chip 一個外框；排程紀錄的引用卡（M24 4.7.3）：引用文字加「查看原紀錄」（紀錄已清掉時停用） -->
                        <Border Classes="chip" Classes.folder="{Binding IsFolder}" Classes.problem="{Binding HasProblem}" Padding="8,4" ToolTip.Tip="{Binding Tooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:EmojiTextBlock Text="{Binding DisplayName}" MaxWidth="240" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                FontSize="{DynamicResource LumiFontSizeCaption}" IsVisible="{Binding IsScheduledRun, Converter={x:Static BoolConverters.Not}}" />
                            <ctl:EmojiTextBlock Text="{Binding QuoteText}" MaxWidth="320" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                VerticalAlignment="Center" FontSize="{DynamicResource LumiFontSizeCaption}" IsVisible="{Binding IsScheduledRun}" />
                            <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" Classes="muted" />
                            <Button Classes="tertiary small" IsVisible="{Binding IsScheduledRun}" Content="{Binding ViewOriginalText}"
                                    IsEnabled="{Binding IsRunGone, Converter={x:Static BoolConverters.Not}}"
                                    Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).OpenQuotedRunCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border HorizontalAlignment="Right" Padding="16,12" CornerRadius="{StaticResource LumiRadiusCard}"
                          Background="{DynamicResource LumiUserBubbleBrush}">
                    <!-- 長的 prompt 預設收合成前幾行（MaxLines=0 是不限制），下方「顯示全部／收合」切換 -->
                    <StackPanel Spacing="4">
                      <ctl:EmojiTextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxLines="{Binding UserTextMaxLines}" TextTrimming="CharacterEllipsis"
                                          Foreground="{DynamicResource LumiUserBubbleTextBrush}" />
                      <Button x:Name="UserTextToggle" Classes="tertiary small" IsVisible="{Binding IsLongUserText}" HorizontalAlignment="Right"
                              Content="{Binding UserTextToggleText}" Command="{Binding ToggleUserTextCommand}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                </ctl:FractionWidthLimiter>

                <!-- 助理：靠左；左側 32 圓形頭像，右側是「Lumi」與時間、淡底氣泡、動作列 -->
                <ctl:FractionWidthLimiter Classes="assistant" IsVisible="{Binding IsAssistant}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Left">
                  <Border Grid.Column="0" Classes="avatar" VerticalAlignment="Top">
                    <TextBlock Text="{x:Static res:Strings.TitleBar_LogoMark}" FontWeight="Bold"
                               Foreground="{DynamicResource LumiAccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="sender" Text="{x:Static res:Strings.Workbench_AssistantName}" />
                      <TextBlock Classes="muted message-time" Text="{Binding TimeText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 回覆附件（M25，ui-spec 3.1）：前面工具產生的牌陣、圖片，放在氣泡上方 -->
                    <views:ReplyAttachmentsView IsVisible="{Binding HasReplyAttachments}" />
                    <!-- 只放附件的訊息被停止：附件下方說明，不在氣泡裡（ui-spec 3.1） -->
                    <TextBlock IsVisible="{Binding ShowStoppedNote}" Text="{x:Static res:Strings.Workbench_Stopped}" Classes="muted" />

                    <!-- 淡底氣泡（對話內容，不算卡片）：思考過程、Markdown、等待與停止提示 -->
                    <Border x:Name="AssistantBubble" IsVisible="{Binding ShowBubble}" HorizontalAlignment="Left" Padding="16,12"
                            CornerRadius="{StaticResource LumiRadiusCard}" Background="{DynamicResource LumiAssistantBubbleBrush}">
                      <StackPanel Spacing="8">
                        <!-- 思考過程：M1 最簡版，正式樣式在 M2（Q14） -->
                        <Expander Classes="advanced" IsVisible="{Binding HasThinking}" Header="{Binding ThinkingTitle}"
                                  HorizontalAlignment="Stretch">
                          <ctl:EmojiTextBlock Text="{Binding Thinking}" TextWrapping="Wrap"
                                              Foreground="{DynamicResource LumiTextMutedBrush}"
                                              FontSize="{DynamicResource LumiFontSizeCard}" />
                        </Expander>
                        <!-- 助理的回答用 Markdown 渲染；使用者訊息與思考過程維持純文字 -->
                        <md:MarkdownView IsVisible="{Binding HasText}" Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}" />
                        <!-- 已送出、文字還沒來（不論有沒有附件）：會動的三個圓點（ui-spec 3.1 R4）；高度 16 加上氣泡的 Padding 12＋12 = 40 -->
                        <StackPanel x:Name="TypingDots" Classes="typing-dots" Orientation="Horizontal" Spacing="4" MinHeight="16"
                                    AutomationProperties.Name="{x:Static res:Strings.Workbench_Waiting}">
                          <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                              <Binding Path="ShowTypingIndicator" />
                              <Binding Path="ShowTypingDots" />
                            </MultiBinding>
                          </StackPanel.IsVisible>
                          <Ellipse Classes="dot1"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
                          <Ellipse Classes="dot2"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
                          <Ellipse Classes="dot3"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
                        </StackPanel>
                        <TextBlock IsVisible="{Binding IsStopped}" Text="{x:Static res:Strings.Workbench_Stopped}" Classes="muted" />
                      </StackPanel>
                    </Border>

                    <!-- 動作列：複製、重新產生（只有最後一則）、👍👎（停用，說明即將推出）、本輪 token -->
                    <StackPanel x:Name="MessageActions" IsVisible="{Binding ShowActions}" Orientation="Horizontal" Spacing="4">
                      <Button Classes="tertiary small message-action" IsVisible="{Binding CanCopy}"
                              Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{x:Static res:Strings.Workbench_CopyTip}" AutomationProperties.Name="{Binding CopyLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <ctl:LumiIcon IsVisible="{Binding !IsCopied}" Data="{StaticResource LumiIconCopy}" Size="14" />
                          <ctl:LumiIcon IsVisible="{Binding IsCopied}" Data="{StaticResource LumiIconCheck}" Size="14" />
                          <TextBlock Classes="action-label" Text="{Binding CopyLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tertiary small message-action" IsVisible="{Binding IsLastAssistant}"
                              Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).RegenerateCommand}"
                              ToolTip.Tip="{x:Static res:Strings.Workbench_RegenerateTip}" AutomationProperties.Name="{x:Static res:Strings.Workbench_Regenerate}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <ctl:LumiIcon Data="{StaticResource LumiIconRefresh}" Size="14" />
                          <TextBlock Classes="action-label" Text="{x:Static res:Strings.Workbench_Regenerate}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <!-- 開支線（M36 4.8「入口」）：每則有文字的助理回答都有；回應中或已在第二層時停用，說明放在 Tooltip -->
                      <!-- 顯示條件在外層 Border（隱藏時整列不佔位，也不算進動作按鈕） -->
                      <Border IsVisible="{Binding ShowBranchAction}">
                        <Button Classes="tertiary small message-action" IsEnabled="{Binding CanBranch}"
                                Command="{Binding $parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).StartBranchCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding BranchTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{x:Static res:Strings.Branch_Start}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <ctl:LumiIcon Data="{StaticResource LumiIconGitBranch}" Size="14" />
                            <TextBlock Classes="action-label" Text="{x:Static res:Strings.Branch_Start}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Border>
                      <!-- 回答這則的模型（FT-03）：設定開啟時顯示，在 token 用量前面 -->
                      <TextBlock x:Name="ModelLabel" Text="{Binding ModelId}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasModel" />
                            <Binding Path="$parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).ShowModelName" />
                          </MultiBinding>
                        </TextBlock.IsVisible>
                      </TextBlock>
                      <TextBlock x:Name="UsageLabel" Text="{Binding UsageText}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasUsage" />
                            <Binding Path="$parent[views:ConversationView].((vm:WorkbenchViewModel)DataContext).ShowTokenUsage" />
                          </MultiBinding>
                        </TextBlock.IsVisible>
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Grid>
                </ctl:FractionWidthLimiter>
              </Panel>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
        </Border>
        <Border x:Name="BranchRailGrow" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="False"
                IsVisible="False" Background="{DynamicResource LumiAccentBrush}" RenderTransformOrigin="0%,0%">
          <Border.RenderTransform><ScaleTransform ScaleY="0" /></Border.RenderTransform>
        </Border>
        </Grid>

        <!-- 整理中（M22 22I）：等待中的樣式（淡底氣泡），摘要呼叫進行時顯示在訊息區底部 -->
        <Border IsVisible="{Binding IsCompacting}" HorizontalAlignment="Left" Padding="16,12" CornerRadius="{StaticResource LumiRadiusCard}"
                Background="{DynamicResource LumiAssistantBubbleBrush}">
          <TextBlock Text="{x:Static res:Strings.Compact_InProgress}" Classes="muted" />
        </Border>

        <!-- 整理失敗（M22 22I）：警告樣式的提示，不擋繼續送出；對話內容沒有改變 -->
        <Border IsVisible="{Binding HasCompactionFailure}" Padding="16,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Static res:Strings.Compact_Failed}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource LumiWarningTextBrush}" />
            <Button Grid.Column="1" Classes="tertiary" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{x:Static res:Strings.Workbench_DismissNotice}" Command="{Binding DismissCompactionFailureCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Workbench_DismissNotice}" />
          </Grid>
        </Border>

        <!-- 停止列（FX-07）：回應還沒有任何內容就按了停止，空的回答不存檔；不是錯誤，用一般的淡色文字，不用警告色 -->
        <Grid x:Name="StoppedRow" IsVisible="{Binding IsStoppedWithoutReply}" ColumnDefinitions="*,Auto">
          <TextBlock Text="{x:Static res:Strings.Workbench_Stopped}" Classes="muted" VerticalAlignment="Center" />
          <Button x:Name="StoppedRetryButton" Grid.Column="1" Classes="secondary" Margin="12,0,0,0" VerticalAlignment="Center"
                  Content="{x:Static res:Strings.Workbench_Retry}" Command="{Binding RetryCommand}" />
        </Grid>

        <!-- 錯誤列：原因 + 對話內容已保留 + 重試（ui-spec 第 3 節） -->
        <Border IsVisible="{Binding HasError}" Padding="16,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource LumiWarningBackgroundBrush}"
                BorderBrush="{DynamicResource LumiWarningBorderBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource LumiWarningTextBrush}" />
              <TextBlock Text="{x:Static res:Strings.Workbench_ErrorKept}" Classes="muted" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
              <!-- 錯誤列動作區只有一個 primary：「重試」（最常見的下一步）；「用其他模型重試」是備選，secondary -->
              <Button x:Name="RetryOtherModelButton" Classes="secondary" Content="{x:Static res:Strings.Workbench_RetryOtherModel}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <views:ModelPicker DataContext="{Binding RetrySwitcher}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="RetryButton" Classes="primary" Content="{x:Static res:Strings.Workbench_Retry}" Command="{Binding RetryCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>

  <!-- 「問這段」（M36 E8）：選取助理回答的文字、放開滑鼠後出現在滑鼠上方 8；按鈕不搶焦點，選取保留到按下為止 -->
  <Popup x:Name="AskPopup" Placement="Pointer" VerticalOffset="-40" IsLightDismissEnabled="True">
    <Border Classes="ask-popup">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="AskCopyButton" Classes="tertiary small" Focusable="False" Content="{x:Static res:Strings.Branch_Copy}" />
        <Button x:Name="AskButton" Classes="tertiary small" Focusable="False" AutomationProperties.Name="{x:Static res:Strings.Branch_Ask}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ctl:LumiIcon Data="{StaticResource LumiIconGitBranch}" Size="14" />
            <TextBlock Text="{x:Static res:Strings.Branch_Ask}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Popup>

  <!-- 回到最新訊息（FT-01）：往上捲離開底部時浮在訊息區底部中央；36 圓形 secondary 按鈕，浮起才有陰影（ui-guide 第 9 節） -->
  <Border x:Name="JumpToBottomHost" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
          CornerRadius="18" BoxShadow="{DynamicResource LumiCardHoverShadow}">
    <Button x:Name="JumpToBottomButton" Classes="secondary round"
            ToolTip.Tip="{x:Static res:Strings.Workbench_JumpToBottom}"
            AutomationProperties.Name="{x:Static res:Strings.Workbench_JumpToBottom}">
      <ctl:LumiIcon Data="{StaticResource LumiIconArrowDown}" Size="16" />
    </Button>
  </Border>
  </Panel>
</UserControl>
