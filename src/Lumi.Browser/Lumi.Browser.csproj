<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lumi.Browser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumi.Browser.Tests" />
  </ItemGroup>

  <!-- Playwright 只能出現在這個專案（架構測試 BrowserLibraryRuleTests 守住） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- 畫流程圖用的 mermaid.js（MIT，授權在 Assets/mermaid.LICENSE.txt），在無頭瀏覽器裡離線執行 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\mermaid.min.js" LogicalName="Lumi.Browser.mermaid.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumi.Core\Lumi.Core.csproj" />
  </ItemGroup>

</Project>
